{
  "name": "purrsonal",
  "dockerComposeFile": "docker-compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "usernamehw.errorlens",
        "hzgood.dart-data-class-generator",
        "redhat.vscode-xml"
      ]
    }
  },
  "mounts": [
    "source=pub-cache-volume,target=/home/vscode/.pub-cache,type=volume",
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "containerEnv": {
    "PUB_CACHE": "/home/vscode/.pub-cache"
  },
  "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.pub-cache && flutter pub get"
}